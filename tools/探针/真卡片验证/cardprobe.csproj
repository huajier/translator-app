<Project Sdk="Microsoft.NET.Sdk">

  <!--
    真卡片验证探针（第 2 版）：反射加载产品 DLL，不编译期引用。
    这样不用处理产品的一堆依赖，也不会和产品的命名空间冲突。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cardprobe</AssemblyName>
    <RootNamespace>CardProbe</RootNamespace>
    <NoWarn>$(NoWarn);CS8618;CS8602;CS8604;MSB3277</NoWarn>
  </PropertyGroup>

</Project>
