<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>baibian</AssemblyName>
    <RootNamespace>baibian</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\..\src\Core\Capture\ImagePreprocessor.cs" Link="ImagePreprocessor.cs" />
    <Compile Include="..\..\..\src\Core\Logging\AppLogger.cs" Link="AppLogger.cs" />
    <Compile Include="..\..\..\src\Core\Capture\TesseractOcr.cs" Link="TesseractOcr.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>
</Project>
