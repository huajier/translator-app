<Window x:Class="TranslatorApp.UI.Shared.DebugToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框选坐标提示"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        Focusable="False"
        IsTabStop="False">

    <!--
        DebugToastWindow —— 框选完成后弹出来的小提示卡。

        这个窗口干嘛的：
          框选完成后，在选区**旁边**弹一个小卡片。
          阶段 2：显示坐标（验证框得准不准）；
          阶段 3：先秒显坐标，认字完成后换成识别出来的文字。

        【ShowActivated="False" —— 不写这一行会抢走焦点】
          WPF 的 Window.Show() **默认会把窗口激活（抢到前台）**。
          本程序要靠鼠标键盘钩子工作，抢走焦点会让用户操作失灵。
          所以这里必须显式声明「显示但不激活」。

        【卡片必须待在选区外面 —— 这是阶段 3 修的一个大坑】
          早先卡片摆在选区左上角**里面**，而弹出时机又早于截图，
          于是 OCR 认出来的是卡片上写的坐标，用户框的文字反而读不到。
          摆放逻辑见 PlaceBesideSelection()。
    -->
    <!--
        【2026-10-08 用户反馈，两条都改在这里】
          ① 「停留时间太短了，改成鼠标移上去就不消失，没移上去 3 秒后消失」
          ② 「太长的文字超出对话框大小就被省略掉了，我要完整显示」
             → 去掉了 MainText 上限 120 字的截断，改为原文全文照登；
             → 外面套 ScrollViewer，卡片再长也不会跑出屏幕。
    -->
    <!--
        【2026-10-15 用户反馈，两条都改在这里】
          ③ 「弹框可以拖动」→ 整张卡片左键按住就能挪走；
             处理在窗口自己的 MouseLeftButtonDown/Move/Up 上（见 .xaml.cs）。
             踩点：**点在文字上不算拖动**，要让位给选字。
          ④ 「弹框里的文字可以用鼠标选中」→ MainText 从 TextBlock 换成 TextBox。
             WPF 的 TextBlock 压根不支持选字（那是 WinUI 才有的 IsTextSelectionEnabled），
             只读 TextBox 是原生做法：无边框、透明底、只读，外观和 TextBlock 一致，
             但能拖选 + Ctrl+C。**不引第三方控件。**
    -->
    <!--
        【2026-11-05 第17轮：卡片里的滚动条改成深色】
          用户原话「很出戏」—— WPF 默认滚动条是浅灰底 + 上下两个白色箭头按钮，
          贴在这张深蓝卡片上像贴了两个白补丁。
          不带 x:Key 的隐式样式，一次覆盖卡片里两个滚动区（TextScroll / TransScroll），
          不用给两个 ScrollViewer 各写一份。
          四个颜色全部取自卡片里已有的色值（#FF1E293B 是 TransSep 那条横线、
          #FF38BDF8 是原文的字色），没有新颜色。
          不做上下箭头按钮：Track 里只放 Thumb 一个元素，直接铺满 8px 宽。
    -->
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="#FF1E293B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#FF1E293B" CornerRadius="4">
                            <!-- 四个 TemplateBinding 不能省：Track 靠它们跟 ScrollViewer
                                 互通位置，漏一个就变成「滑块画得出来但拖不动 / 不跟着走」。 -->
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Maximum="{TemplateBinding Maximum}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="#FF475569"
                                                        CornerRadius="3"
                                                        Margin="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background" Value="#FF38BDF8" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background" Value="#FF38BDF8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F20F172A" CornerRadius="6" Padding="10,7"
            BorderBrush="#FF38BDF8" BorderThickness="1">
        <Grid>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="框选完成"
                           Foreground="#FF94A3B8" FontSize="11" Margin="0,0,0,3" />

                <!-- 全文照登，靠 ScrollViewer 限高。MaxHeight 随卡片位置动态调整。 -->
                <ScrollViewer x:Name="TextScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="300">
                  <Grid>
                    <TextBox x:Name="MainText" Foreground="#FF38BDF8"
                             FontSize="13" FontWeight="Bold"
                             TextWrapping="Wrap" MaxWidth="420"
                             IsReadOnly="True"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Disabled" />
                    <!-- 【2026-11-11 第20轮「句句对照」】逐句富文本版原文。
                         和上面的 MainText 同一个位置、二选一显示：
                           开关关 or 句数不等 → MainText 显示、MainRich 隐藏（和以前完全一致）
                           开关开 and 句数相等 → MainRich 显示、MainText 隐藏
                         ⚠️ RichTextBox 会吃掉滚轮，必须在 PreviewMouseWheel 里
                            e.Handled=false 让外层 TextScroll 收到（探针实测踩过）。 -->
                    <RichTextBox x:Name="MainRich"
                                 Foreground="#FF38BDF8"
                                 FontSize="13" FontWeight="Bold"
                                 MaxWidth="420"
                                 Visibility="Collapsed"
                                 IsReadOnly="True"
                                 IsDocumentEnabled="False"
                                 IsTabStop="False"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 CaretBrush="Transparent"
                                 VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseWheel="OnRichPreviewMouseWheel" />
                  </Grid>
                </ScrollViewer>

                <!--
                    【2026-11-05 第16轮 P0-J1：原文详情紧跟原文】
                      这块原来在整张卡片的最底下，原文的详情跟原文之间隔了一整个译文块，
                      用户读译文时不知道这是谁翻的。现在顺序是：
                        原文 / 原文详情 / 分隔线 / 译文 / 译文详情
                      每块字下面跟自己的身份证 —— 原文详情紧跟原文，译文详情紧跟译文。
                      只挪了位置，逻辑代码一行没动（显隐还是原来那套 Collapsed/Visible）。
                -->
                <TextBlock x:Name="DetailText" Foreground="#FFCBD5E1"
                           FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="420" />

                <!--
                    【2026-11-02 阶段四 T3a：译文区】
                      原文在上（蓝、加粗），译文在下（白、不加粗），中间一条细线分开。
                      默认 Visibility="Collapsed"：没有译文时**一行都不占**，
                      所以「翻译关着」和「现在没有翻译」的卡片跟阶段三长得一模一样。
                    译文用 TextBox 而不是 TextBlock：和 MainText 一样要能拖选 + Ctrl+C
                      （用户框到一段外文，多半是想把译文复制走，而不是光看）。
                    【2026-11-03 P0-E2：译文必须限高】
                      原来只限 MaxWidth，一段 300 字的剧情文本译完会撑到 250~350px，
                      加原文区 80px 就顶出屏幕，详情行和失败原因看不见，
                      卡片还会被 PlaceBesideSelection() 摆到屏幕外，用户以为程序没反应。
                      现在套进 ScrollViewer 限高 200：原文 80 + 译文 200 = 正文最多 280px。
                      显隐只动 TransScroll 和 TransSep，TranslationText 自己不管 Visibility。
                -->
                <Border x:Name="TransSep" Height="1" Background="#FF1E293B"
                        Margin="0,6,0,6" Visibility="Collapsed" />
                <ScrollViewer x:Name="TransScroll" MaxHeight="200"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                  <Grid>
                    <TextBox x:Name="TranslationText" Foreground="#FFE2E8F0"
                             FontSize="13" TextWrapping="Wrap" MaxWidth="420"
                             IsReadOnly="True"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Disabled" />
                    <!-- 【2026-11-11 第20轮「句句对照」】逐句富文本版译文。二选一规则同上。 -->
                    <RichTextBox x:Name="TransRich"
                                 Foreground="#FFE2E8F0"
                                 FontSize="13"
                                 MaxWidth="420"
                                 Visibility="Collapsed"
                                 IsReadOnly="True"
                                 IsDocumentEnabled="False"
                                 IsTabStop="False"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 CaretBrush="Transparent"
                                 VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseWheel="OnRichPreviewMouseWheel" />
                  </Grid>
                </ScrollViewer>

                <!--
                    【2026-11-04 v2.0：译文详情行】
                      和原文详情行同一个格式：谁翻的 · 花了多久 · 多少字。
                      单独一个控件而不是复用 DetailText：缓存命中时两行数字不一样
                      （原文行是认字耗时，译文行是 0 ms），挤在一行会互相打架。
                -->
                <TextBlock x:Name="TransDetail" Foreground="#FF94A3B8"
                           FontSize="11" Margin="0,3,0,0"
                           TextWrapping="Wrap" MaxWidth="420"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</Window>