<Window x:Class="TranslatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻译软件"
        Height="360"
        Width="540"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="#F5F5F5">
    <!--
        【2026-11-05 第17轮：主窗口去掉说明书，只留控件 + 两个问号】
          用户原话「乱七八糟的提示删了，ai味太重了」。
          改前是三块：粗体标题（怎么用 / 关于翻译 / 翻译设置）+ 两条横线 + 三大段正文。
          改后只有两行：开关 + 问号、译成 + 下拉 + 问号，说明全进 tooltip。

        【为什么 tooltip 要 ShowDuration=60000】
          WPF 默认 5 秒就收，四行字根本没读完就没了 → 用户只能反复把鼠标移开再移回来。
          60 秒足够读完，鼠标一移开还是会关，不会赖着不走。

        【隐私披露一个字都没删，只是搬进了第一个问号的 tooltip】
          托盘菜单那句「翻译：把文字发给微软（勾选 = 开）」也还在，两处都在。

        【标题不在这里定】实际标题由 MainWindow.xaml.cs 的 `Title = App.WindowTitle` 赋值，
        上面 Title="翻译软件" 只是给设计器预览（单实例查找靠 App.WindowTitle，写错了会找错窗口）。
        【版本号不在这里写】改 TranslatorApp.csproj 的 Version，标题自动跟着变。

        【x:Name 一个都不能改名】TranslateCheck / LangBox 被 .xaml.cs 十几个事件方法引用。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,18,24,18">
        <StackPanel>

            <!-- 第一行：翻译开关 + 问号（隐私披露全在这个 tooltip 里） -->
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="TranslateCheck"
                          VerticalAlignment="Center"
                          Content="打开翻译"
                          Checked="OnTranslateChecked"
                          Unchecked="OnTranslateUnchecked" />
                <TextBlock Text="?"
                           FontSize="12"
                           Foreground="#777777"
                           Width="18"
                           Height="18"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           Cursor="Help">
                    <TextBlock.ToolTip>
                        <ToolTip MaxWidth="320" ToolTipService.ShowDuration="60000">
                            <TextBlock TextWrapping="Wrap">框到的文字会发到微软翻译服务。
只发文字，不发截图、不发窗口标题、不发程序名。
关掉翻译，就一个字都不外发。
翻译默认是开着的，第一次启动会弹一次说明。</TextBlock>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
            </StackPanel>

            <!-- 第二行：目标语言 + 问号（怎么框选、怎么填语言码、× 不是退出，都在这里） -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="译成："
                           VerticalAlignment="Center"
                           Foreground="#333333" />
                <ComboBox x:Name="LangBox"
                          Width="250"
                          Height="26"
                          VerticalAlignment="Center"
                          IsEditable="True"
                          SelectionChanged="OnLangSelectionChanged"
                          LostFocus="OnLangLostFocus"
                          KeyDown="OnLangKeyDown" />
                <TextBlock Text="?"
                           FontSize="12"
                           Foreground="#777777"
                           Width="18"
                           Height="18"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           Cursor="Help">
                    <TextBlock.ToolTip>
                        <ToolTip MaxWidth="320" ToolTipService.ShowDuration="60000">
                            <TextBlock TextWrapping="Wrap">按住 Ctrl + Alt，在屏幕上按住鼠标左键拖出一个框，把要认的文字框住，松手。
右下角会弹出卡片显示原文，翻译开着的话下面还有译文。
上面没有的语言，直接在下拉框里填语言代码（如 ja、de、xx-YY），回车或点别处生效。
窗口右上角的 × 只是缩到托盘，不是退出；退出请右键托盘图标 → 退出。</TextBlock>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
