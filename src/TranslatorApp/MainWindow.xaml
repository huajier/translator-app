<Window x:Class="TranslatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻译软件"
        SizeToContent="Manual"
        Height="420"
        MinHeight="360"
        MinWidth="540"
        ResizeMode="CanResize"
        Width="540"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="#F5F5F5">
    <!--
        【2026-11-05 第17轮：主窗口去掉说明书，只留控件 + 图标】
          用户原话「乱七八糟的提示删了，ai味太重了」。

        【2026-11-05 第18轮：图标、光标、tooltip 三个收尾】
          · 问号从纯文本 "?" 换成圆圈内问号 U+E9CE（Segoe MDL2 Assets，Windows 10/11 自带）。
            【不要用 U+2753（❓）】Windows 上它落到 Segoe UI Emoji，会渲染成红色彩色 emoji，
            和这个黑白灰界面打架。这个坑已经踩过一次，别再踩。
          · 问号上的 Cursor="Help" 全删（用户不要「箭头旁边带个黑问号」那个光标），
            删掉就是默认箭头 —— 不要写 Cursor="Arrow"，那是多此一举。
          · 第一个问号的 tooltip 只留一句「将框选后识别出来的内容发送到翻译服务。请注意不要框选私密、
            敏感内容！」：原来那四行（只发文字 / 关掉不外发 / 默认开着）讲的是隐私实现细节，
            跟「打开翻译」这个开关要做的决定不相关，全删。
          · 第二个问号连图标带 tooltip 整个删掉：它讲的是怎么框选、手填语言码、× 不是退出，
            跟「翻译语言」这件事毫无关系。留一个空 tooltip 的图标比没有更莫名其妙。
          · 「怎么用」这句话改由下拉框下面那行正文承担（只此一行，退出方式不再写进主窗口）。

        【为什么 tooltip 要 ShowDuration=60000】
          WPF 默认 5 秒就收，字没读完就没了 → 用户只能反复把鼠标移开再移回来。

        【隐私披露一个字都没删】
          托盘菜单那句「翻译：把文字发给微软（勾选 = 开）」还在；
          第一个 tooltip 里「发送到翻译服务」+「不要框选私密、敏感内容」也在。

        【标题不在这里定】实际标题由 MainWindow.xaml.cs 的 `Title = App.WindowTitle` 赋值，
        上面 Title="翻译软件" 只是给设计器预览（单实例查找靠 App.WindowTitle，写错了会找错窗口）。
        【版本号不在这里写】改 TranslatorApp.csproj 的 Version，标题自动跟着变。

        【x:Name 一个都不能改名】TranslateCheck / LangBox 被 .xaml.cs 十几个事件方法引用。
    -->
    <!--
        【2026-11-06 第21轮：删掉 ScrollViewer，高度交给内容】

        主窗口内容只有三行且固定，不需要滚动，所以不用 ScrollViewer。
        SizeToContent="Height" 让窗口永远刚好包住内容 —— 改文案不用再重算高度，
        系统字体放大时窗口也跟着变高，不会裁字。

        （第 19/20 轮那两段关于「ScrollViewer 撑满窗口、底部 Padding 18、
          160 的算式、为什么不用 SizeToContent」的注释已删：它们描述的结构不存在了。
          那三轮反复改 360→200→160 的根因就是：留着一个为三大段说明加的滚动容器，
          它唯一的作用是「差 4px 就冒滚动条」，逼着在 160/164 之间选。
          164 只是「实测刚好不滚」的临界点，字号 / DPI / 系统字体任一变化都会复发。）
    -->
        <!--
        【2026-11-11 第18轮：根节点从 StackPanel 换成 Grid】
          用户要求「识别记录框随主窗口大小变化」。StackPanel 不分配剩余空间，
          窗口改成可拖大小后记录区不会跟着长，所以必须换成 Grid + 最后一个 Row 用 *。
          前四行的文字、顺序、tooltip 一个字都没动，只是加了 Grid.Row。
    -->
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 第1行 打开翻译 -->
            <RowDefinition Height="Auto" />   <!-- 第2行 翻译语言 -->
            <RowDefinition Height="Auto" />   <!-- 第3行 游戏字识别 -->
            <RowDefinition Height="Auto" />   <!-- 第4行 使用说明 -->
            <RowDefinition Height="Auto" />   <!-- 第5行 句句对照开关 -->
            <RowDefinition Height="Auto" />   <!-- 第6行 识别记录标题 + 详情 -->
            <RowDefinition Height="*" />      <!-- 第7行 记录区，吃掉剩余空间 -->
        </Grid.RowDefinitions>

        <!-- 第一行：翻译开关 + 圆圈问号（唯一还留着的图标） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <CheckBox x:Name="TranslateCheck"
                      VerticalAlignment="Center"
                      Content="打开翻译"
                      Checked="OnTranslateChecked"
                      Unchecked="OnTranslateUnchecked" />
            <!-- 图标字号 14 比正文大一点才不至于糊成一团；VerticalAlignment=Center 跟复选框文字对齐 -->
            <TextBlock Text="&#xE9CE;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="14"
                       Foreground="#777777"
                       Width="18"
                       Height="18"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0">
                <TextBlock.ToolTip>
                    <ToolTip MaxWidth="320" ToolTipService.ShowDuration="60000">
                        <TextBlock TextWrapping="Wrap">将框选后识别出来的内容发送到翻译服务。请注意不要框选私密、敏感内容！</TextBlock>
                    </ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
        </StackPanel>

        <!-- 第二行：翻译语言 + 下拉框（这一行已经没有图标了） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="翻译语言："
                       VerticalAlignment="Center"
                       Foreground="#333333" />
            <ComboBox x:Name="LangBox"
                      Width="250"
                      Height="26"
                      VerticalAlignment="Center"
                      IsEditable="True"
                      SelectionChanged="OnLangSelectionChanged"
                      LostFocus="OnLangLostFocus"
                      KeyDown="OnLangKeyDown" />
        </StackPanel>

        <!-- 第三行：RapidOCR 引擎开关（2026-11-09 用户要求「开关不能放在主页面里面吗」） -->
        <!-- 只有一个勾选框，取舍说明全部放进 tooltip（DESIGN.md：主窗口不许有大段说明） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <CheckBox x:Name="RapidOcrCheck"
                      VerticalAlignment="Center"
                      Content="游戏字识别（快）"
                      Checked="OnRapidOcrChecked"
                      Unchecked="OnRapidOcrUnchecked">
                <CheckBox.ToolTip>
                    <ToolTip MaxWidth="320" ToolTipService.ShowDuration="60000">
                        <TextBlock TextWrapping="Wrap">开：长文本快（2 秒级），但小字可能读歪&#x0a;关：长文本准，但慢很多（可能十几秒）</TextBlock>
                    </ToolTip>
                </CheckBox.ToolTip>
            </CheckBox>
        </StackPanel>

        <!-- 第四行：怎么用（只这一句；退出方式不写进来，用户拍板过） -->
        <TextBlock Grid.Row="3"
                   Text="按住 Ctrl + Alt 在屏幕上拖出一个框，松手就能识别并翻译。"
                   FontSize="12"
                   Foreground="#777777"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0" />

        <!-- 第五行：句句对照开关（2026-11-11 第20轮 用户需求，默认关）
             样式照第三行「游戏字识别（快）」那个 CheckBox -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
            <CheckBox x:Name="SentenceHighlightCheck"
                      VerticalAlignment="Center"
                      Content="句句对照"
                      Checked="OnSentenceHighlightChecked"
                      Unchecked="OnSentenceHighlightUnchecked">
                <CheckBox.ToolTip>
                    <ToolTip MaxWidth="320" ToolTipService.ShowDuration="60000">
                        <TextBlock TextWrapping="Wrap">开：鼠标移到某一句，原文和右边译文一起高亮（这一版不能逐句翻译，是整段翻完再切句）&#x0a;关：和以前一样</TextBlock>
                    </ToolTip>
                </CheckBox.ToolTip>
            </CheckBox>
        </StackPanel>

        <!-- 第六行：识别记录标题 + 「详情」按钮（2026-11-11 用户反馈 2：要像标题+控件，
             不能和下面那句灰色说明文字一样） -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,14,0,4">
            <TextBlock Text="识别记录"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       VerticalAlignment="Center" />
            <Button x:Name="HistoryButton"
                    Content="详情"
                    FontSize="12"
                    Foreground="#333333"
                    Background="White"
                    BorderBrush="#999999"
                    BorderThickness="1"
                    Cursor="Hand"
                    Padding="10,2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Click="OnHistoryClick">
                <Button.ToolTip>
                    <ToolTip MaxWidth="320" ToolTipService.ShowDuration="60000">
                        <TextBlock TextWrapping="Wrap">不小心把结果点掉了，可以在这里找回最近 10 次识别（含译文）。</TextBlock>
                    </ToolTip>
                </Button.ToolTip>
            </Button>
        </StackPanel>

        <!-- 第六行：常驻记录区（2026-11-11 用户反馈 1/3：
             · 随窗口大小变化 —— 用 Grid 的 * 行 + VerticalAlignment=Stretch，不再写死高度
             · 描边像「翻译语言」下拉框 —— 用 WPF ComboBox 默认边框色 #ABADB3） -->
        <!-- 滚动条由外层 ScrollViewer 提供，里面那个 TextBox 自己不要再出一条 -->
        <!-- 【2026-11-11 第19轮】描边改由外层 Border 画。
             原因：ScrollViewer 自己的 BorderBrush 配 Background="White" + 内层 TextBox 铺满时
             被遮住了（实测边框处从灰底直接跳到纯白，中间没有 #999999 像素）。
             Border 永远画在自己背景之上，最稳。BorderThickness=1 + #999999 比下拉框略深一点：
             记录区面积大，1px 太浅会「撑不住」。 -->
        <Border Grid.Row="6"
                VerticalAlignment="Stretch"
                BorderBrush="#999999"
                BorderThickness="1"
                Background="White"
                Margin="0,4,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          Padding="2">
                <TextBox x:Name="HistoryBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         FontSize="12"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Disabled"
                         Padding="8"
                         Background="Transparent" />
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
