<Window x:Class="TranslatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻译软件 v0.1 · 空壳"
        Height="300"
        Width="480"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="#F5F5F5">
    <!--
        阶段 1 的空壳窗口：只放两段文字，用来证明 WPF 渲染正常。
        标题以 MainWindow.xaml.cs 里的 MainWindow.WindowTitle 为准，这里这份只是给设计器预览。
    -->
    <StackPanel Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="翻译软件 · 最小骨架（v0.1）"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1A1A1A"
                   HorizontalAlignment="Center" />
        <TextBlock Margin="0,12,0,0"
                   Text="这是一个能运行的空壳程序。&#10;右下角托盘有图标，右键菜单可以「显示主窗口 / 退出」。&#10;点窗口右上角 × 只会缩到托盘，不会退出程序。&#10;双击 exe 只会启动一个实例。"
                   TextAlignment="Center"
                   FontSize="13"
                   LineHeight="24"
                   Foreground="#444444"
                   TextWrapping="Wrap" />
    </StackPanel>
</Window>
